# ==============================================================================
# CraftByHanifa - Environment Variables Example
# Salin file ini menjadi .env.local dan isi dengan kredensial yang valid.
# ==============================================================================

# Supabase Configuration (Database & Storage)
# Dapatkan dari Dashboard Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Panel Admin Authentication (Server-Side Only - Jangan gunakan prefix NEXT_PUBLIC_)
ADMIN_EMAIL=craftbyhanifa@gmail.com
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_SESSION_SECRET=generate-a-long-random-secret-key-here
